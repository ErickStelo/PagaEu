PAGAEU_PUBLIC_URL=https://painel.example
PAGAEU_ADMIN_USER=
PAGAEU_ADMIN_PASSWORD=
PAGAEU_ADMIN_EMAIL=
PAGAEU_LOGIN_CODE_DISABLED=false
# Host local (npm start): 127.0.0.1. Docker prod: host postgres na rede PAGAEU_DOCKER_NETWORK.
# O compose de dev sobrescreve DATABASE_URL para o container postgres.
DATABASE_URL=postgres://webmaster:SENHA@127.0.0.1:5432/pagaeu
PAGAEU_DOCKER_NETWORK=postgres_default
PAGAEU_PORT=3010

# Opcional: importados na primeira subida se o Evolution ainda não estiver no painel.
# EVOLUTION_GO_URL=https://evolution.example
# EVOLUTION_GO_API_KEY=
# EVOLUTION_GO_INSTANCE=
