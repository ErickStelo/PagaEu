# PagaEu — produção (pagaeu.starkss.com.br)
# Referência local; no servidor: sites-available + sites-enabled
# sudo nginx -t && sudo systemctl reload nginx
#
# No .env: PAGAEU_PUBLIC_URL=https://pagaeu.starkss.com.br
# Backend: PAGAEU_PORT no host (aqui 9885 → container na 3000).

upstream pagaeu_backend {
    server 127.0.0.1:9885;
    keepalive 16;
}

# HTTP: renovação Let's Encrypt e redirect para HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name pagaeu.starkss.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: tráfego real do painel
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pagaeu.starkss.com.br;

    ssl_certificate /etc/letsencrypt/live/pagaeu.starkss.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pagaeu.starkss.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;

    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location ~ (^|/)\.env {
        deny all;
        return 404;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_pass http://pagaeu_backend;
    }
}
