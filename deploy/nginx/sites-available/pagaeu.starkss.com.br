# PagaEu — copiar para /etc/nginx/sites-available/pagaeu.starkss.com.br
# sudo ln -sf /etc/nginx/sites-available/pagaeu.starkss.com.br /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
#
# No .env do PagaEu: PAGAEU_PUBLIC_URL=http://pagaeu.starkss.com.br
#
# O compose de produção publica a app em 127.0.0.1:3000 (PAGAEU_PORT no host).

upstream pagaeu_backend {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name pagaeu.starkss.com.br;

    client_max_body_size 2m;

    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;

    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location ~ (^|/)\.env {
        deny all;
        return 404;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_pass http://pagaeu_backend;
    }
}
