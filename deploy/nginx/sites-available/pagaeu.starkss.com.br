# PagaEu — copiar para /etc/nginx/sites-available/pagaeu.starkss.com.br
# sudo ln -sf /etc/nginx/sites-available/pagaeu.starkss.com.br /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
#
# Certificado (primeira vez): sudo certbot --nginx -d pagaeu.starkss.com.br
# No .env do PagaEu: PAGAEU_PUBLIC_URL=https://pagaeu.starkss.com.br
#
# O compose de produção publica a app em 127.0.0.1:3000 (PAGAEU_PORT no host).

upstream pagaeu_backend {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name pagaeu.starkss.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pagaeu.starkss.com.br;

    ssl_certificate     /etc/letsencrypt/live/pagaeu.starkss.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pagaeu.starkss.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location ~ (^|/)\.env {
        deny all;
        return 404;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_pass http://pagaeu_backend;
    }
}
